# Copy to .env and adjust as needed. Never commit real secrets.
# This project uses only synthetic local data, so no API keys are required.

# --- Paths (all relative paths resolve from the repo root) ---
DATA_DIR=data/output
TELEMETRY_JSONL=data/output/telemetry_logs.jsonl
EMPLOYEES_CSV=data/output/employees.csv
DUCKDB_PATH=data/analytics.duckdb

# --- Synthetic dataset size (used by `make data` / docker entrypoint) ---
GEN_NUM_USERS=100
GEN_NUM_SESSIONS=5000
GEN_DAYS=60
GEN_SEED=42

# --- Dashboard ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
